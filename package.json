{
  "name": "promptimizer",
  "private": true,
  "description": "BYOK OpenAI-compatible LLM router with quality-aware model routing and prompt caching.",
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "apps/web",
    "packages/sdk",
    "packages/cli"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@promptimizer/web",
    "dev:web": "npm run dev --workspace=@promptimizer/web",
    "dev:sdk": "npm run dev --workspace=promptimizer",
    "build": "npm run build --workspace=@promptimizer/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=promptimizer && npm run test --workspace=@promptimizer/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs": "cd apps/docs && npx --yes mintlify@latest dev",
    "publish:sdk": "node scripts/publish-npm.mjs",
    "promptimizer": "node packages/cli/bin/promptimizer.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
