{
  "name": "promptimizer",
  "private": true,
  "description": "BYOK OpenAI-compatible LLM router with quality-aware model routing and prompt caching.",
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "apps/web",
    "packages/sdk"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@promptimizer/web",
    "dev:web": "npm run dev --workspace=@promptimizer/web",
    "dev:sdk": "npm run dev --workspace=promptimizer",
    "build": "npm run build --workspace=@promptimizer/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=promptimizer",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
