# Promptimizer — copy to `.env` and fill values.
# Never commit `.env`. Same names on Vercel / Compose.

# --- app ---
APP_ENV=development
LOG_LEVEL=info
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PROMPTIMIZER_API_URL=
PROMPTIMIZER_URL=http://localhost:3000/api
PROMPTIMIZER_API_KEY=

# --- accounts (required) ---
# Postgres: Neon, Supabase, RDS, or local
DATABASE_URL=
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 48 — encrypts customer provider keys
ENCRYPTION_KEY=
SESSION_SECRET=
SESSION_TTL_SECONDS=14400

# --- Upstash Redis (production cache on Vercel) ---
# Console → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional TCP URL from the same database (FastAPI / Compose)
UPSTASH_REDIS_URL=
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600

# --- npm publish (`promptimizer` package) ---
# npmjs.com → Access Tokens → Granular Access Token (read and write)
NPM_TOKEN=
NODE_AUTH_TOKEN=

# --- optional default provider (BYOK in the console still wins) ---
DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
BASETEN_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
MOONSHOT_API_KEY=
OLLAMA_API_KEY=

# --- quality ---
QUALITY_GUARD=true
QUALITY_ESCALATE_THRESHOLD=0.62
QUALITY_ROUTE_ECONOMY=0.90
QUALITY_ROUTE_STANDARD=0.72
