# Promptimizer
APP_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Cache: memory | redis
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Optional hosted defaults (BYOK still wins when a session is connected)
DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER_API_KEY=

# Session encryption for BYOK keys at rest in Redis/memory
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=14400

# Quality guard: escalate if a cheap answer looks degraded
QUALITY_GUARD=true
QUALITY_ESCALATE_THRESHOLD=0.62

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
