# Promptimizer — copy to `.env` and fill values.
# Never commit `.env`. Same names on Vercel / Compose.

# --- app ---
APP_ENV=development
LOG_LEVEL=info
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PROMPTIMIZER_API_URL=
PROMPTIMIZER_URL=http://localhost:3000/api
PROMPTIMIZER_API_KEY=

# --- accounts (required) ---
# Postgres: Neon, Supabase, RDS, or local
DATABASE_URL=
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 48 — encrypts customer provider keys
ENCRYPTION_KEY=
SESSION_SECRET=
SESSION_TTL_SECONDS=14400

# --- Google sign-in (OAuth 2.0 Web client) ---
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth client → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on that client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- transactional email (Gmail app password) ---
# Google Account → Security → 2-Step Verification → App passwords
GOOGLE_MAIL_USER=
GOOGLE_MAIL_PASSWORD=

# --- Upstash Redis (production cache on Vercel) ---
# Console → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional TCP URL from the same database (FastAPI / Compose)
UPSTASH_REDIS_URL=
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
SESSION_CACHE_TTL_SECONDS=86400
PROVIDER_TIMEOUT_MS=55000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=20
RATE_LIMIT_CHAT=120
RATE_LIMIT_CONNECT=30

# --- npm publish (`promptimizer` package) ---
# npmjs.com → Access Tokens → Granular Access Token (read and write)
NPM_TOKEN=
NODE_AUTH_TOKEN=

# --- optional default provider (BYOK in the console still wins) ---
DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
BASETEN_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
MOONSHOT_API_KEY=
OLLAMA_API_KEY=

# --- quality / routing ---
QUALITY_GUARD=true
QUALITY_ESCALATE_THRESHOLD=0.62
# Periodic accuracy audit every N chat completions (re-check coverage / thin / refusal)
QUALITY_AUDIT_EVERY=5
# Live router: minimum measured quality for quality_profile policy
MIN_QUALITY=0.72
# Optional latency budget (ms) — documented; bootstrap path still uses escalate heuristics
MAX_LATENCY_MS=30000
# Legacy aliases (prefer MIN_QUALITY for quality_profile policy)
QUALITY_ROUTE_ECONOMY=0.90
QUALITY_ROUTE_STANDARD=0.72

# --- semantic similarity cache ---
SEMANTIC_CACHE=true
# Reuse when cosine similarity ≥ this (0–1). Default 0.5 = 50%.
SEMANTIC_THRESHOLD=0.5
# Full answer replay when similarity ≥ this (hybrid below this, above SEMANTIC_THRESHOLD)
SEMANTIC_FULL_HIT=0.88
SEMANTIC_CACHE_SIZE=200
# Dual-write Redis even when Qdrant succeeds (set 0 to Qdrant-only)
SEMANTIC_DUAL_WRITE=1

# --- Qdrant semantic vector store (Cloud or self-hosted) ---
# Local compose: http://qdrant:6333  |  Cloud: https://….aws.cloud.qdrant.io
# Web uses Qdrant when QDRANT_URL is set. SEMANTIC_BACKEND=python is for the FastAPI twin only.
SEMANTIC_BACKEND=shared
QDRANT_URL=
QDRANT_API_KEY=
# 2048-d collection for nvidia/nemotron-3-embed-1b (do not reuse a 256-d collection)
QDRANT_COLLECTION=promptimizer_semantic_2048

# Allow anonymous BYOK connect without login (local demo). Production: leave unset / 0.
ALLOW_ANON_CONNECT=1

# Embeddings (notebook default: nvidia/nemotron-3-embed-1b @ 2048-d via NVIDIA Integrate)
NVIDIA_API_KEY=
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048
