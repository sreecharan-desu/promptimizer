{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@promptimizer/web",
  "outputDirectory": "apps/web/.next",
  "redirects": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "docs.promptimizer.site" }],
      "destination": "https://www.promptimizer.site/api/:path*",
      "permanent": true
    }
  ]
}
