{
  "name": "promptimizer",
  "version": "0.1.73",
  "description": "OpenAI-compatible SDK for Promptimizer — BYOK model routing, classification, and prompt caching.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers": {
      "types": "./src/providers.ts",
      "import": "./src/providers.ts",
      "default": "./src/providers.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/classify.test.ts src/providers.test.ts",
    "publish:npm": "npm publish --access public"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./providers": {
        "types": "./dist/providers.d.ts",
        "import": "./dist/providers.js",
        "require": "./dist/providers.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sreecharan-desu/promptimizer.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://www.promptimizer.site",
  "bugs": {
    "url": "https://github.com/sreecharan-desu/promptimizer/issues"
  },
  "keywords": [
    "llm",
    "openai",
    "router",
    "prompt-cache",
    "byok",
    "cost-optimization"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.8.0"
  }
}
